# Copy to .env (git-ignored). Never commit real values.
# All values are optional: scripts/run-harness.ps1 fills TK_APP_URL, TK_ORG_URL and TK_DATAVERSE_TOKEN from pac/az.
# Play URL of the published canvas app (Power Apps > Timekeeper App > Details > Web link)
TK_APP_URL=https://apps.powerapps.com/play/e/<environment-id>/a/<app-id>
# Dataverse org URL (Power Platform admin center > environment > Environment URL)
TK_ORG_URL=https://<org>.crm.dynamics.com
# Optional: bearer token for the API contract check. Get one with:
#   az login ; az account get-access-token --resource $env:TK_ORG_URL --query accessToken -o tsv
TK_DATAVERSE_TOKEN=
# Demo identities typed on the sign-in panel
TK_EMPLOYEE_EMAIL=priya@example.com
TK_MANAGER_EMAIL=jordan@example.com   # the -ManagerEmail you passed to setup-environment.ps1
TK_UNREGISTERED_EMAIL=nobody@example.com
# Display names used in assertions
TK_EMPLOYEE_NAME=Priya Patel
TK_MANAGER_NAME=Jordan Lee
TK_REPORT_NAMES=Priya Patel,Alex Kim
# Tests that change shared demo data (submit week, approve/reject) only run when this is 1
TK_ALLOW_MUTATIONS=0
